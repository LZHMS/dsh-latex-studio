{
  "name": "@zhaulee/dsh-latex-studio",
  "version": "1.1.1",
  "type": "module",
  "description": "LaTeX Studio：在 DSH 右侧栏编辑 .tex（语法高亮、自动折行、字号快捷键），一键编译 pdflatex/xelatex/lualatex，实时预览 PDF 并支持代码→PDF 同步跳转；主文档自动发现，子文件也能直接编译。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LZHMS/dsh-latex-studio.git"
  },
  "homepage": "https://github.com/LZHMS/dsh-latex-studio#readme",
  "bugs": "https://github.com/LZHMS/dsh-latex-studio/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "latex",
    "tex",
    "pdf",
    "synctex"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "assets",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
